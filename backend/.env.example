# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tradesimulator?schema=public"

# Redis (used for OTP TTL, price cache, Bull queue)
REDIS_URL="redis://localhost:6379"

# JWT
ACCESS_TOKEN_SECRET="change-me-to-a-random-64-char-string"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-to-another-random-64-char-string"
REFRESH_TOKEN_EXPIRES_IN="7d"

# App
PORT=3001
CLIENT_URL="http://localhost:5173"

# Virtual balance defaults (in paise/cents to avoid float issues — stored as NUMERIC)
DEFAULT_INR_BALANCE=1000000
DEFAULT_USD_BALANCE=0

# News API (optional — leave empty to disable news)
NEWSAPI_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# LLM API Keys (optional — leave empty for mock/template explanations)
# RAG layer uses these for embedding generation and price-move explanations
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Mock mode: set REDIS_MOCK=true to avoid needing real Redis
# In mock mode, embeddings and explanations fall back to deterministic algorithms
REDIS_MOCK=true
